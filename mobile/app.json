{
  "expo": {
    "name": "My Campus Ride",
    "slug": "mycampusride",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mycampusride.app"
    },
    "android": {
      "package": "com.mycampusride.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#173B32"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#173B32"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "My Campus Ride uses your location to show how far each bus is from you."
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/d175eac5-90b0-4e8d-811c-d2602f5996d9"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "d175eac5-90b0-4e8d-811c-d2602f5996d9"
      }
    },
    "owner": "hasnainjaffer"
  }
}
