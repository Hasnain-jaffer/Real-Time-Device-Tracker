# URL of your deployed backend (no trailing slash)
SERVER_URL=server_url_here

# Must be identical to BRIDGE_SECRET set on the backend (Render env vars)
BRIDGE_SECRET=bridge_secret_here

# Port the tracker connects to (open this in the AWS security group)
TCP_PORT=tcp_port_here

# Drop a tracker connection after this long without any packet (default 10 min)
IDLE_TIMEOUT_MS=time_in_ms_here

# Set to true to log the raw hex of every chunk (use once with the real tracker, then turn off)
LOG_RAW=false