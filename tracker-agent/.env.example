# The server this agent reports to
SERVER_URL=http://localhost:5000

# Get this from the Device Center in the app (Register Bus -> Show device key)
DEVICE_KEY=dev_your_device_key_here

# How often to send a location update, in milliseconds
REPORT_INTERVAL_MS=5000

# Location source: "gps" (real GPS via serial NMEA device) or "simulate" (for demo/testing)
LOCATION_SOURCE=simulate

# Only used when LOCATION_SOURCE=simulate — starting point and simple wander radius
SIMULATE_START_LAT=25.4610
SIMULATE_START_LNG=68.7183
SIMULATE_WANDER_METERS=50