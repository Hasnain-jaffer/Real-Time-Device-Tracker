# Node.js environment
NODE_ENV=production
PORT=5000
CLIENT_URL=https://your-app.vercel.app

MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/device-tracker?retryWrites=true&w=majority

JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM="Device Tracker <onboarding@resend.dev>"